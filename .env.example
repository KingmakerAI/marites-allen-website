# Admin bootstrap (used only when the CMS has no users yet)
ADMIN_EMAIL=admin@maritesallen.com
ADMIN_PASSWORD=change-this-password

# Public site URL
NEXT_PUBLIC_SITE_URL=https://maritesallen.com

# Durable content on Vercel. Create a Blob store on the project; Vercel adds this token.
# Without it, articles and photos saved in the admin on Vercel can disappear after a restart.
# Locally the site keeps using data/cms.json, so leave this unset unless you are pushing content.
# BLOB_READ_WRITE_TOKEN=

# Email via Resend (https://resend.com) — required for password reset + booking enquiry alerts
# RESEND_API_KEY=
# RESET_FROM_EMAIL=Website editor <noreply@maritesallen.com>
# BOOKING_FROM_EMAIL=Marites Allen Website <noreply@maritesallen.com>
# BOOKING_NOTIFY_TO=hello@maritesallen.com
