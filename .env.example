# Admin bootstrap (used only when the CMS has no users yet)
ADMIN_EMAIL=admin@maritesallen.com
ADMIN_PASSWORD=change-this-password

# Public site URL
NEXT_PUBLIC_SITE_URL=https://maritesallen.com

# Durable content on Vercel. Create a Blob store on the project; Vercel adds this token.
# Without it, articles and photos saved in the admin on Vercel can disappear after a restart.
# Locally the site keeps using data/cms.json, so leave this unset unless you are pushing content.
# BLOB_READ_WRITE_TOKEN=

# Required on Vercel. Signs the admin login cookie. Sign-in fails until this is set.
# Local development uses a built-in dev key when this is unset. Do not commit a real value.
# ADMIN_SESSION_SECRET=
# Required on Vercel to create owner logins. Do not commit a real value.
# OWNER_BOOTSTRAP_PASSWORD=

# Email via Resend (https://resend.com) — password reset, booking alerts, and the press kit link.
# Without RESEND_API_KEY and a from address, press kit registration still saves and the visitor can download the file.
# The page says email was not sent. It does not say "Sent".
# The from address must be a verified sender in Resend.
# RESEND_API_KEY=
# RESET_FROM_EMAIL=Website editor <noreply@maritesallen.com>
# BOOKING_FROM_EMAIL=Marites Allen Website <noreply@maritesallen.com>
# BOOKING_NOTIFY_TO=hello@maritesallen.com
# NEXT_PUBLIC_SITE_URL is used as the link inside the press kit email. On the live site set it to https://www.maritesallen.com if this file's value is not already that.
